# Environment Configuration Example
# Copy to .env and modify as needed

# Application/Environment
NODE_ENV=production
ENVIRONMENT=development

# Docker
DOCKER_REGISTRY=gitlab.com
DOCKER_IMAGE_NAME=eduprime
DOCKER_IMAGE_TAG=latest

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# Application
APP_NAME=IF-EDUprime
APP_VERSION=1.0.0
APP_URL=http://localhost

# Logging
LOG_LEVEL=info

# Security
ENABLE_GZIP=true
MAX_UPLOAD_SIZE=20M

# Caching
CACHE_STATIC=true
CACHE_TTL_IMAGES=2592000
CACHE_TTL_CSS_JS=2592000
CACHE_TTL_HTML=3600

# Git/CI-CD
CI_REGISTRY_USER=your-username
CI_REGISTRY_PASSWORD=your-token
CI_PROJECT_PATH=Ourajeenn/eduprime
